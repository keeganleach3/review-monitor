# Copy to .env and fill in; `python -m review_monitor` reads ./.env. .env is gitignored: never commit it.

# The agent's model. Without a key, runs use the deterministic keyword tagger instead (no model calls).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-5-5

# Google Sheet output (--sheet google). See README > Run it.
SHEET_ID=
GOOGLE_APPLICATION_CREDENTIALS=/path/outside/this/repo/service-account.json

# Failure summary by email. Without these, it is written to alerts.log.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=

# Optional overrides; normally read from Airbnb's own page at runtime.
AIRBNB_WEB_API_KEY=
AIRBNB_REVIEWS_QUERY_HASH=
